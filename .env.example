# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=hrd_analytics_db
POSTGRES_PORT=5432

# Database Connection URL
DATABASE_URL=postgresql://postgres:your_secure_password@postgres:5432/hrd_analytics_db

# Redis Configuration
REDIS_URL=redis://redis:6379

# App Configuration
PORT=3000
JWT_SECRET=your_jwt_secret_key_here
